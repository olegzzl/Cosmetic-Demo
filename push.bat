@echo off
chcp 65001 >nul
echo =======================================
echo   Отправка изменений на GitHub
echo =======================================

:: Добавляем все измененные файлы
git add .

:: Запрашиваем описание коммита у пользователя
set /p commit_msg="Введите описание изменений (или нажмите Enter для 'Авто-коммит'): "
if "%commit_msg%"=="" set commit_msg="Автоматический коммит"

:: Делаем коммит
git commit -m "%commit_msg%"

:: Отправляем на GitHub
echo.
echo Отправляю файлы на GitHub...
git push origin main

echo.
echo =======================================
echo   Готово! Код успешно обновлен на GitHub.
echo =======================================
pause
